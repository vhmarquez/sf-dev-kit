# Shell scripts must be LF for the bash shebang to resolve on every platform.
*.sh    text eol=lf
*.bash  text eol=lf

# Windows batch / cmd scripts are CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Source and config — prefer LF for consistency.
*.md           text eol=lf
*.json         text eol=lf
*.xml          text eol=lf
*.cls          text eol=lf
*.cls-meta.xml text eol=lf
*.js           text eol=lf
*.html         text eol=lf
*.css          text eol=lf

# Binary blobs — never normalize.
*.png  binary
*.jpg  binary
*.gif  binary
*.zip  binary
*.jar  binary
